{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solpbc.org/schemas/solstone-windows-finalization-receipt/v1.json",
  "title": "solstone Windows finalization receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "version",
    "target",
    "source_commit",
    "cargo_lock_sha256",
    "ui_package_lock_sha256",
    "companion_manifest",
    "candidate",
    "packaged_executable",
    "selection_record_sha256",
    "signing_mode",
    "advisory_database",
    "advisory_checked_at"
  ],
  "properties": {
    "schema": {
      "enum": [
        "solstone.rust-release-finalization.v1",
        "solstone.rust-release-finalization.v2"
      ]
    },
    "product": { "const": "solstone-windows" },
    "version": { "type": "string", "minLength": 1 },
    "target": { "const": "x86_64-pc-windows-msvc" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
    "ui_package_lock_sha256": { "$ref": "#/$defs/sha256" },
    "companion_manifest": { "$ref": "#/$defs/companion_manifest" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "packaged_executable": { "$ref": "#/$defs/packaged_executable" },
    "selection_record_sha256": { "$ref": "#/$defs/sha256" },
    "signing_mode": {
      "enum": ["unsigned", "signed-verified"]
    },
    "advisory_database": { "$ref": "#/$defs/advisory_database" },
    "advisory_checked_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "companion_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "file_count"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "file_count": { "enum": [7, 8] }
      }
    },
    "packaged_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "advisory_database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "commit", "tree_sha256", "acquired_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "tree_sha256": { "$ref": "#/$defs/sha256" },
        "acquired_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
